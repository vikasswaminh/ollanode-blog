---
// ExploreBlogCTA.astro - Subtle bottom CTA section linking back to the main blog page
---

<section class="explore-blog-cta-section">
  <div class="explore-cta-card">
    <div class="explore-cta-content">
      <h2 class="explore-cta-heading">Explore the Blog</h2>
      <p class="explore-cta-subheading">
        Read the latest insights, guides, and ideas from Ollanode.
      </p>
    </div>
    <div class="explore-cta-action">
      <a href="/" class="btn-explore-all">
        View All Articles
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .explore-blog-cta-section {
    width: 100%;
    padding: 1rem 1.5rem 5rem;
  }

  .explore-cta-card {
    max-width: 78rem;
    margin: 0 auto;
    background: #ffffff;
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 2.75rem 2.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
  }

  @media (prefers-color-scheme: dark) {
    .explore-cta-card {
      background: var(--bg-soft);
    }
  }

  @media (max-width: 768px) {
    .explore-blog-cta-section {
      padding: 1rem 1rem 3.5rem;
    }
    .explore-cta-card {
      flex-direction: column;
      text-align: center;
      padding: 1.75rem 1.25rem;
      gap: 1.25rem;
    }
    .explore-cta-heading {
      font-size: 1.25rem;
    }
    .explore-cta-subheading {
      font-size: 0.84rem;
    }
    .btn-explore-all {
      font-size: 0.84rem;
      padding: 0.65rem 1.35rem;
    }
  }

  .explore-cta-heading {
    font-size: 1.65rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--text);
    margin: 0 0 0.4rem;
    font-family: var(--font);
  }

  .explore-cta-subheading {
    font-size: 1rem;
    color: var(--muted);
    margin: 0;
  }

  .btn-explore-all {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #111827;
    color: #ffffff !important;
    border: 1px solid #111827;
    font-weight: 700;
    font-size: 0.95rem;
    padding: 0.75rem 1.6rem;
    border-radius: 10px;
    text-decoration: none;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .btn-explore-all:hover {
    background: #000000;
    border-color: #000000;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.2);
    text-decoration: none;
  }

  .btn-explore-all svg {
    transition: transform 0.15s ease;
  }

  .btn-explore-all:hover svg {
    transform: translateX(3px);
  }
</style>
