---
import FormattedDate from './FormattedDate.astro';

interface Props {
  url: string;
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
  minutes?: number;
}
const { url, title, description, pubDate, tags = [], minutes } = Astro.props;
const categoryAttr = tags.join(' ').toLowerCase();
---

<article class="post-card-highlight" data-category={categoryAttr}>
  <div class="post-card-inner">
    {tags.length > 0 && (
      <div class="post-card-badge-row">
        {tags.map((t) => (
          <span class="post-card-tag-pill">{t}</span>
        ))}
      </div>
    )}
    <h3 class="post-card-title"><a href={url}>{title}</a></h3>
    <p class="post-card-desc">{description}</p>
    <div class="post-card-meta">
      <FormattedDate date={pubDate} />
      {minutes ? <span class="meta-dot">·</span> : null}
      {minutes ? <span>{minutes} min read</span> : null}
      <a href={url} class="post-card-read-more">Read article →</a>
    </div>
  </div>
</article>
