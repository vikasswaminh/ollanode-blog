---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../utils/posts';

const posts = await getPublishedPosts();
const counts = new Map<string, number>();
for (const p of posts) {
  for (const t of p.data.tags) {
    counts.set(t, (counts.get(t) ?? 0) + 1);
  }
}
const categories = [...counts.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="Categories" description="Browse posts by category and topic.">
  <h1 class="page-title">Categories</h1>
  {categories.length === 0 && <p class="empty">No categories found.</p>}
  <div class="tag-cloud">
    {
      categories.map(([cat, n]) => (
        <a class="tag tag-lg" href={`/tags/${cat}/`}>
          {cat} <span class="tag-count">({n})</span>
        </a>
      ))
    }
  </div>
</BaseLayout>
